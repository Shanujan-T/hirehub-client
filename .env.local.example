# HireHub client → API connection (local development)
#
# Recommended local setup (AI needs a direct Flask URL — Next rewrites time out):
NEXT_PUBLIC_API_URL=
HIREHUB_API_URL=http://127.0.0.1:5000
NEXT_PUBLIC_HIREHUB_API_URL=http://127.0.0.1:5000

# Production (Railway) example:
# NEXT_PUBLIC_API_URL=
# HIREHUB_API_URL=https://your-api.up.railway.app
# NEXT_PUBLIC_HIREHUB_API_URL=https://your-api.up.railway.app
